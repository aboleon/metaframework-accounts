{
    "name": "aboleon/metaframework-accounts",
    "description": "Accounts and invoices domain package for MetaFramework applications.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/view": "^12.0",
        "illuminate/translation": "^12.0",
        "illuminate/mail": "^12.0",
        "maatwebsite/excel": "^3.1",
        "barryvdh/laravel-dompdf": "^3.1",
        "aboleon/metaframework": "dev-mfw-2026||^1.0",
        "aboleon/metaframework-google-places": "^1.2",
        "aboleon/metaframework-mailer": "0.*",
        "aboleon/metaframework-mediaclass": "0.*"
    },
    "autoload": {
        "psr-4": {
            "MetaFramework\\Accounts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MetaFramework\\Accounts\\Tests\\": "tests/",
            "App\\": "tests/stubs/App/"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0",
        "laravel/pint": "^1.27"
    },
    "extra": {
        "laravel": {
            "providers": [
                "MetaFramework\\Accounts\\Providers\\AccountsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
